# Development defaults; do not commit a populated .env.local file.
NODE_ENV=development
APP_ORIGIN=http://localhost:3000

DATABASE_URL=
OPENAI_API_KEY=
# Optional model override; the application defaults to gpt-4.1.
OPENAI_GRADING_MODEL=
ATTENDANCE_AUTH_USER=
ATTENDANCE_AUTH_PASS=
TEACHER_COOKIE_SECRET=
STUDENT_COOKIE_SECRET=
# Set only to the exact source IPs of trusted reverse proxies, comma-separated.
# Leave blank when the app receives connections directly; never trust arbitrary
# X-Forwarded-For values.
TRUSTED_PROXY_IPS=
